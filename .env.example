# Copy to .env and set a password.
POSTGRES_DB=vacancies
POSTGRES_USER=vacancies
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
# How often each kind of source is checked, in minutes: the job-alert inbox, job boards
# (Just Join IT, remote boards, Hacker News) and company careers feeds and pages.
EMAIL_INTERVAL_MINUTES=15
BOARD_INTERVAL_MINUTES=120
ATS_INTERVAL_MINUTES=360
LOG_LEVEL=INFO
# Just Join IT: role words matched against advert URLs, pause between page requests,
# and the most advert pages opened per run (the rest wait for the next run).
# JUSTJOINIT_KEYWORDS=python,engineering-manager,head-of-engineering,director,staff,principal,tech-lead
JUSTJOINIT_DELAY_SECONDS=2
JUSTJOINIT_MAX_PAGES=500
# Himalayas: role searches (comma-separated) and pages of 20 per search.
# HIMALAYAS_QUERIES=python,engineering manager,staff engineer,head of engineering
HIMALAYAS_MAX_PAGES=5
ARBEITNOW_MAX_PAGES=10
# Port for the results page on this machine (http://localhost:8080).
WEB_PORT=8080
# Job-alert inbox (LinkedIn, Welcome to the Jungle, No Fluff Jobs alerts), over IMAP.
# Leave IMAP_USER empty to switch the email collector off. Keep the password only in .env
# (for iCloud, an app-specific password from account.apple.com).
# IMAP_USER=you@icloud.com
# IMAP_PASSWORD=
IMAP_HOST=imap.mail.me.com
IMAP_PORT=993
IMAP_FOLDER=INBOX
# Alerts that were parsed are moved here; everything else stays in IMAP_FOLDER.
IMAP_TRASH_FOLDER=Deleted Messages
# Jobs close once their newest alert is older than this many days.
EMAIL_ALERT_DAYS=30
